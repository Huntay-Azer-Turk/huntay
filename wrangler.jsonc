{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "huntay",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "huntay"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Paketler/fiyatlar veritabanı (lib/packages.ts). Tablo ilk istekte kendiliğinden oluşur.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huntay-site",
      "database_id": "3c6c0890-5692-4d7e-9598-c3105e861dd8"
    }
  ],
  // /admin: Cloudflare Access ile korunur (lib/admin-auth.ts). Değerler gizli değildir.
  "vars": {
    "ADMIN_EMAILS": "huntay.azerturk@gmail.com",
    "ACCESS_TEAM_DOMAIN": "nameless-flower-a39f.cloudflareaccess.com",
    "ACCESS_AUD": "60319b766c6d63b8d24cdecd80c2d5de7c084140260fa885f6f4a95563a86e02"
  },
  "observability": {
    "enabled": true
  }
}
